# Public URL Street is deployed at. Used for sitemap.xml, canonical/OG tags.
NEXT_PUBLIC_SITE_URL=https://street.example.com

# Public Google Analytics 4 web-stream ID for streetdotcom.com.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-E621RKXPX3

# Cloudflare Web Analytics site token (Cloudflare dashboard > Analytics & Logs
# > Web Analytics > Add a site > streetdotcom.com > copy the token out of the
# snippet it gives you). Public by design — it ships in every page's HTML.
# Analytics is skipped entirely if this isn't set.
NEXT_PUBLIC_CF_BEACON_TOKEN=

STREET_FIRST_BRAND_URL=https://www.seventyfouruniform.com

# Existing Street database API URL. This points to the self-hosted,
# Supabase-compatible PostgREST service on the Netcup VPS — not Supabase Cloud.
# The variable name is retained because the app's existing data layer uses the
# Supabase-compatible REST API.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only service-role key for the VPS database API. Never expose this in
# browser code or send it in chat.
SUPABASE_SERVICE_ROLE_KEY=

# Used by Vercel Cron to authorize the daily catalog refresh.
CRON_SECRET=

# Password for /admin (homepage hero, brand logos/links, product category
# overrides, analytics). Required — /admin/login refuses every attempt until
# this is set. Pick something long and random; there's no username, just this.
ADMIN_PASSWORD=

# Homepage hero image/video and the featured-brand spotlight are no longer
# env vars — they're editable at /admin/homepage (stored in the site_settings
# table) so they can change without a redeploy.

# OpenRouter API key used for AI product classification (categorizing new
# products into the Street taxonomy) and the /admin/brands/new logo finder's
# AI fallback. Already configured in Vercel if classification is running.
OPENROUTER_API_KEY=

# Self-hosted imgproxy endpoint (img.streetdotcom.com) - resizes/reformats
# (WebP) catalog images from known non-Shopify brand hosts on the fly. Safe
# to expose client-side (it's a public delivery URL, not a secret; the proxy
# itself is locked down by a source-host allowlist). Falls back to serving
# those brands' images unresized if this isn't set.
NEXT_PUBLIC_IMAGE_PROXY_URL=

# OpenRouter model slug for classification. Defaults to a cheap, text-only
# DeepSeek model (no product photos are analyzed — see lib/ai-product-classifier.ts).
STREET_CLASSIFIER_MODEL=deepseek/deepseek-chat

# --- Admin accounts, sessions and alerts (added with the admin overhaul) ---

# Optional. Secret used to sign admin session cookies. If unset, a value is
# derived from SUPABASE_SERVICE_ROLE_KEY (or ADMIN_PASSWORD), which is fine.
# Set it only if you want session signing to be independent of those.
ADMIN_SESSION_SECRET=

# Break-glass. Once personal accounts exist, the shared ADMIN_PASSWORD stops
# working. Set this to "true" ONLY if you need the shared password to keep
# working as an emergency way in (for example if every owner is locked out).
# Leave it unset day to day.
ADMIN_ALLOW_LEGACY_LOGIN=

# Optional daily alert digest (GitHub cron calls /api/cron/alerts). Nothing is
# sent unless at least one destination is configured.
#   Slack: an Incoming Webhook URL.
ALERT_SLACK_WEBHOOK_URL=
#   Email through Resend (needs RESEND_API_KEY as well): a verified sender and
#   one or more comma-separated recipients.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Fit Wars results email. Uses the existing Resend account and Street email
# settings. The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_SENDING_DOMAIN=mail.streetdotcom.com
